# Environment variables & secrets (CRITICAL: Never commit to version control)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
server/.env
client/.env
client/.env.local
SETUP_AND_CREDENTIALS.md
*CREDENTIALS*.md

# Allow example templates
!.env.example
!server/.env.example
!client/.env.example

# Dependencies
node_modules/
client/node_modules/
server/node_modules/

# Production build artifacts
dist/
client/dist/
build/
bundle.js

# Temporary & scratch files
scratch/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Server uploaded media (keep .gitkeep so folder exists)
server/uploads/*
!server/uploads/.gitkeep

# System & IDE artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/
