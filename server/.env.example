# MongoDB connection string (MongoDB Atlas or local)
MONGO_URI=mongodb://127.0.0.1:27017/univo

# Port the API + Socket.io server listens on
PORT=5000

# JWT secret used to sign auth tokens - change this to a long random string
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# URL of the React client (for CORS + socket.io)
CLIENT_URL=http://localhost:5173

# Override before deployment. Local development defaults to admin@univo.edu / Univo@123.
ADMIN_NAME=Univo Admin
ADMIN_EMAIL=admin@univo.edu
ADMIN_PASSWORD=Univo@123

# Anthropic API key, used by the AI Chat Bot feature (Resources -> Ask AI)
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Model used for the AI Chat Bot
ANTHROPIC_MODEL=claude-sonnet-4-6
