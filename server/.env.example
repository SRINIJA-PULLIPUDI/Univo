# =============================================================================
# UNIVO SERVER ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `server/.env` and fill in your values.
# =============================================================================

# --- Database ---
# MongoDB connection string (MongoDB Atlas cluster URI or local MongoDB)
# Example Local: mongodb://127.0.0.1:27017/univo
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/univo?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/univo

# --- Server & Security ---
PORT=5000
NODE_ENV=development

# JWT secret key for signing authentication tokens (Generate a long random 64-char string)
JWT_SECRET=your_super_secret_jwt_key_replace_with_random_string
JWT_EXPIRES_IN=7d

# Frontend client origin URL (Used for CORS and Socket.io handshake permissions)
CLIENT_URL=http://localhost:5173

# --- Initial Bootstrap Admin Credentials ---
# Local development auto-bootstraps admin@univo.edu / Univo@123 if no admin exists.
# For production, set strong credentials here before running the server.
ADMIN_NAME=Univo Admin
ADMIN_EMAIL=admin@univo.edu
ADMIN_PASSWORD=Univo@123

# --- AI Campus Co-Pilot (Multi-Provider Fallback Architecture) ---
# Configure ANY of these providers. The engine falls back gracefully down the chain.
# If no API key is provided, the high-precision deterministic local Academic Synthesizer operates.

# 1. Groq Cloud (Recommended: 100% Free Tier, 500+ tokens/sec, Llama 3.3 70B)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# 2. Google Gemini API (Free Tier available)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 3. OpenAI API (Optional)
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 4. Anthropic Claude API (Optional)
# Get a key at: https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- SMTP Mailer Settings (Optional) ---
# Used for dispatching email alerts for announcements, circulars, assignments, and password reset OTPs.
# For Gmail: Use smtp.gmail.com, port 587, and a 16-character App Password (Google Account -> Security -> App Passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Univo Academic Portal" <no-reply@univo.edu>
