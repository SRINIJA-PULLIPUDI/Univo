# Vercel / Client Production Environment Variables (Optional)
# In local development, Vite proxies requests to http://127.0.0.1:5000 automatically.
# When deploying the client on Vercel and backend on Render/Railway, set these in Vercel:

# Backend API URL (Include /api prefix)
# Example: https://univo-server.onrender.com/api
VITE_API_BASE_URL=

# Backend Socket.io Server URL (Without /api prefix)
# Example: https://univo-server.onrender.com
VITE_SOCKET_URL=
